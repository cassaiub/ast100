---
import ChapterOverviewLayout from "../../../layouts/ChapterOverviewLayout.astro";
import Hero from "../../../components/scenes/0/Hero";
import RiverScene from "../../../components/scenes/0/RiverScene";
import ChapterFooter from "../../../components/scenes/0/ChapterFooter.astro";
import { withBase } from "../../../data/course-nav";
---

<ChapterOverviewLayout
  title="0.0 — Seven Ages of the Universe · AST 100"
  description="Fourteen billion years, traced along a river — from the first hot moment of being, through the slow assembly of stars and worlds, to the very recent invention of culture."
  current="/chapter/0/0.0"
>
  <Hero client:load />
  <RiverScene client:load />

  {/* Teaser for the full 25-event timeline, which now lives on its own page. */}
  <section class="relative px-6 md:px-10 py-24 md:py-32">
    <div class="max-w-[1100px] mx-auto">
      <a
        href={withBase("/timeline")}
        class="cta-card surface-card is-link block rounded-xl border overflow-hidden"
      >
        <div class="p-6 md:p-9">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="font-mono text-[13px] tracking-[0.18em] text-plasma">
              cosmic timeline
            </span>
            <span class="font-mono text-[9px] tracking-[0.22em] uppercase text-white/40">
              25 events · 7 ages · 14 Gyr
            </span>
            <span
              class="ml-auto font-mono text-[9px] tracking-[0.22em] uppercase rounded-full px-2.5 py-0.5 text-plasma"
              style="border: 1px solid rgb(var(--c-accent-rgb) / 0.45);"
            >
              ● live
            </span>
          </div>
          <h3
            class="font-serif font-medium leading-tight text-white"
            style="font-size: clamp(1.6rem, 2.8vw, 2.4rem);"
          >
            Twenty-five turning points
          </h3>
          <p class="mt-3 text-[15px] md:text-[16px] leading-[1.6] text-white/70 max-w-[64ch]">
            Every milestone in 14 billion years — the Big Bang, the first
            atoms, the first stars, the first cells, the first cities. The
            full scroll-driven timeline now lives on its own page.
          </p>
          <div class="mt-5 flex items-center gap-2 font-mono text-[10px] tracking-[0.22em] uppercase text-plasma">
            open the timeline
            <span class="inline-block transition-transform duration-500">→</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <ChapterFooter />
</ChapterOverviewLayout>
