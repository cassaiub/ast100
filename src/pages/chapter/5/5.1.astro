import ChapterLayout from "../../../layouts/ChapterLayout.astro";
import Hero from "../../../components/scenes/5.1/Hero";
import PrevNext from "../../../components/scenes/5.1/PrevNext.astro";
import FigureFrame from "../../../components/shared/FigureFrame.astro";
import { PeriodicTablePanel, OnionFurnacePanel } from "../../../components/scenes/5.1/figures";
