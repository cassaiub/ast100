---
import Layout from "../layouts/Layout.astro";

const roles = [
  {
    n: 1,
    title: "The Cosmic Camera",
    subtitle: "How telescopes read the Universe",
    body: "Narrator and visual guide for the group. Explains why we need different telescopes for different wavelengths using the electromagnetic spectrum from Chapter 0.4, and introduces the specific telescopes — Planck, Hubble, JWST, Chandra, ALMA — that the other four students draw from. Opens the story: telescopes are time machines, each image a photograph of a different era of cosmic history.",
    chapter: "0.4",
  },
  {
    n: 2,
    title: "The Oldest Light",
    subtitle: "Images of the Particle Age",
    body: "Works with CMB maps from the Planck satellite — the earliest photograph of the Universe at 380,000 years old. Explains what colour variations mean (density fluctuations, the seeds of future structure), compares COBE, WMAP, and Planck maps to show improving resolution over decades, and hands the CMB's density seeds forward to Role 3's first galaxies.",
    chapter: "1",
  },
  {
    n: 3,
    title: "The First Galaxies",
    subtitle: "Images of the Galactic Age",
    body: "Works with deep field images — the Hubble Ultra Deep Field and JWST deep fields. Explains that looking deeper into space means looking further back in time, identifies the difference between nearby and distant galaxies in the same image, and hands those galaxies forward to Role 4 as the places where stars are born.",
    chapter: "2",
  },
  {
    n: 4,
    title: "Stellar Nurseries & Graveyards",
    subtitle: "Images of the Stellar Age",
    body: "Works with two contrasting sets of images: star-forming regions (the Pillars of Creation, Orion Nebula in infrared from JWST) and stellar remnants (Crab Nebula from Chandra in X-ray, Hubble planetary nebulae). The arc is the complete stellar life cycle — birth to death — told across infrared and X-ray, then hands one rich, multi-wavelength object to Role 5.",
    chapter: "3",
  },
  {
    n: 5,
    title: "One Object, Many Eyes",
    subtitle: "A multi-wavelength story",
    body: "Takes a single famous object — Centaurus A or the Crab Nebula — and shows how it looks completely different across radio, infrared, visible, X-ray, and gamma-ray wavelengths, explaining what each reveals. Closes the story, tying every age back together: the full history of the Universe needs the full spectrum of light.",
    chapter: "0.4",
  },
];

// The three in-class build sessions = the three "Seeing the Seven Ages" progress
// reports on Kriterion (Gather → Develop → Weave). Each is submitted as ≤100
// words + one annotated image (hand-drawn or AI-assisted), and together they
// become the report and the talk. Mirrors PROGRESS_EVENT_DEFS in kriterion route.
const build = [
  {
    n: 1,
    word: "Gather",
    tag: "Progress report 1 · in class",
    essence: "Find the real telescope images your part of the story is built from.",
    doing: [
      "Open Aladin Lite and the archives; pull 2–4 real archival images for your role.",
      "For each, note the object, telescope or mission, wavelength, and archive.",
      "Choose ONE as your anchor — the single image you'll explain next week.",
    ],
    submit:
      "≤ 100 words listing your images and your anchor, plus one annotated image — arrows and a label (object · telescope · wavelength · archive).",
  },
  {
    n: 2,
    word: "Develop",
    tag: "Progress report 2 · in class",
    essence: "Turn your anchor image into understood science.",
    doing: [
      "Work out what your anchor shows and why it looks that way at its wavelength.",
      "Back it with one comparison to a second image.",
      "Check your explanation against your course chapter — correct, not guessed.",
    ],
    submit:
      "≤ 100 words naming the cause, not just the picture, plus one annotated science diagram whose arrows and labels explain WHY (“deeper = older”, “X-ray shell = dying star”).",
  },
  {
    n: 3,
    word: "Weave",
    tag: "Progress report 3 · in class",
    essence: "Link the group's five parts into one continuous story.",
    doing: [
      "Order the five parts along the Particle → Galactic → Stellar timeline.",
      "Work out your two handoffs: what you receive from the role before, and set up for the role after.",
      "Agree the shared thread and lock your one or two hero images.",
    ],
    submit:
      "≤ 100 words naming the roles before and after you and each handoff, plus one annotated storyboard — your hero image, an arrow in from the previous role and out to the next.",
  },
];

const tools = [
  {
    label: "Aladin Lite",
    note: "Browser sky atlas, all wavelengths",
    href: "https://aladin.cds.unistra.fr/AladinLite/",
  },
  {
    label: "NASA HubbleSite",
    note: "Hubble image archive",
    href: "https://hubblesite.org",
  },
  {
    label: "JWST Image Gallery",
    note: "JWST processed releases",
    href: "https://webbtelescope.org",
  },
  {
    label: "ESA Image Archive",
    note: "European Southern Observatory images",
    href: "https://esahubble.org",
  },
  {
    label: "NASA APOD",
    note: "Astronomy Picture of the Day",
    href: "https://apod.nasa.gov",
  },
  {
    label: "Chandra Photo Album",
    note: "X-ray astronomy gallery",
    href: "https://chandra.harvard.edu/photo",
  },
];

const SAMPLE_PRESENTATION = "https://canva.link/g2ii8y73jpzdd7j";

// Both halves are 15 marks, each split into three equal 5-mark parts. The
// report's three parts ARE the three progress reports (Gather / Develop / Weave);
// the talk's three are fixed on Kriterion (Content / Delivery / Interaction,
// PRESENTATION_CRITERION_MAX = 5 in @cassa/shared). Keep in sync with Kriterion.
const reportRubric = [
  { label: "Gather", note: "real, correctly-labelled images", marks: 5 },
  { label: "Develop", note: "the science, tied to the chapters", marks: 5 },
  { label: "Weave", note: "your part connects into one story", marks: 5 },
];
const presentationRubric = [
  { label: "Content", note: "informative, organised slides", marks: 5 },
  { label: "Delivery", note: "preparedness and clear speech", marks: 5 },
  { label: "Interaction", note: "engaging the room, body language", marks: 5 },
];
const reportTotal = reportRubric.reduce((s, r) => s + r.marks, 0);
const presentationTotal = presentationRubric.reduce((s, r) => s + r.marks, 0);

// Concise, actionable tips per report criterion — drawn straight from the
// Gather / Develop / Weave progress-report instructions.
const reportTips = [
  {
    label: "Gather",
    marks: 5,
    blurb: "The evidence — real images, correctly identified.",
    items: [
      "Use real archival images with real names — “Crab Nebula · Chandra · X-ray”, never “a space picture”.",
      "For every image give the object, telescope or mission, wavelength, and archive.",
      "Include your annotated figures — hand-drawn or AI-assisted — a clean, unmarked screenshot doesn't count.",
    ],
  },
  {
    label: "Develop",
    marks: 5,
    blurb: "The understanding — the science behind the picture.",
    items: [
      "Explain the cause, not the caption — why the feature looks that way at that wavelength.",
      "Anchor every claim to your course chapter; don't guess the science.",
      "Back your anchor with one comparison — COBE → Planck detail, deeper = older, X-ray vs optical.",
    ],
  },
  {
    label: "Weave",
    marks: 5,
    blurb: "The synthesis — five parts, one continuous story.",
    items: [
      "Hand off cleanly — name what you receive from the role before you and set up for the role after.",
      "Keep the shared thread visible — the spectrum, “looking out = looking back”, “deeper = earlier”.",
      "Read as one Particle → Galactic → Stellar story, not five stapled essays.",
    ],
  },
];

// Tips per presentation criterion — what earns each of the three 5-mark bands.
const presentationTips = [
  {
    label: "Content",
    marks: 5,
    blurb: "How informative, ordered, and well-organised your slides are.",
    items: [
      "Curate, don't cram — pick the most interesting points you can summarise well, but never skip the core concepts from class.",
      "Bullets, not paragraphs — short lists, and balance each slide so it's neither empty nor overloaded.",
      "Title slide: your name and the title of your assigned part.",
      "Build from the course materials, not random websites or AI summaries.",
      "Use explanatory images and diagrams — you may reuse infographics straight from the course pages.",
    ],
  },
  {
    label: "Delivery",
    marks: 5,
    blurb: "How prepared you are and how clearly you convey the material.",
    items: [
      "Present entirely in English.",
      "Rehearse until your speech is fluid and confident.",
      "Speak to the slide on screen — follow its bullets in order and walk the audience through each image.",
      "Cut filler: keep only the slides you'll actually present.",
      "Stay on time — finish within your allotted minutes.",
    ],
  },
  {
    label: "Interaction",
    marks: 5,
    blurb: "How you engage the screen, the audience, and your body language.",
    items: [
      "Speak spontaneously — don't read off a phone, laptop, or paper.",
      "Split your focus between the screen (point out details) and the audience (make eye contact).",
      "Move around and point toward different parts of the screen; don't freeze in one spot.",
      "Use natural hand gestures to emphasise your points.",
    ],
  },
];
---

<Layout
  title="Midterm Project — Seeing the Seven Ages · AST 100"
  description="A visual journey through the first half of cosmic history using archival telescope data, built over three weeks."
  current="/mid"
>
  {/* ─────────────────────────────  Hero  ───────────────────────────── */}
  <section class="relative -mt-[72px] pt-[160px] md:pt-[200px] pb-24 md:pb-32 px-6 md:px-10">
    <div class="max-w-[1100px] mx-auto">
      <div
        data-fade
        class="font-mono text-[11px] tracking-[0.32em] uppercase text-[var(--c-accent)] mb-7 flex items-center gap-3"
      >
        <span class="block w-9 h-px" style="background: var(--c-accent);"></span>
         Midterm project · a three-week build
      </div>

      <h1
        data-fade
        style="--delay: 220ms"
        class="title-gradient font-serif font-medium tracking-tight leading-[1.04]"
      >
        <span class="block" style="font-size: clamp(2.4rem, 6vw, 4.6rem);">
          Seeing the Seven Ages
        </span>
        <span
          class="block italic font-light mt-3"
          style="font-size: clamp(1.4rem, 3.2vw, 2.2rem); color: var(--c-text-soft);"
        >
          a visual journey through the first half of cosmic history
        </span>
      </h1>

      <p
        data-fade
        style="--delay: 420ms; color: var(--c-text-soft);"
        class="mt-10 max-w-[68ch] text-[17px] md:text-[19px] leading-[1.65]"
      >
        The midterm is a group astrophotography project — built over three weeks
        and delivered as one report and one talk. Each group of 5 tells the story
        of the Universe's first three ages — Particle, Galactic, and Stellar —
        through real archival images taken across the full electromagnetic
        spectrum. You build it in three in-class steps —{" "}
        <span style="color: var(--c-text-strong);">Gather</span>,{" "}
        <span style="color: var(--c-text-strong);">Develop</span>,{" "}
        <span style="color: var(--c-text-strong);">Weave</span> — using{" "}
        <a
          href="https://aladin.cds.unistra.fr/AladinLite/"
          target="_blank"
          rel="noopener"
          style="color: var(--c-accent);"
          class="hover:underline">Aladin Lite</a
        >, a browser sky atlas that shows any patch of sky in radio, infrared,
        visible, X-ray, and microwave light.
      </p>

      <div
        data-fade
        style="--delay: 620ms"
        class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-text-faint)]"
      >
        <span class="flex items-center gap-2">
          <span
            class="inline-block w-2 h-2 rounded-full"
            style="background: var(--c-accent); box-shadow: 0 0 10px rgb(var(--c-accent-rgb) / 0.75);"
          ></span>
           groups of 5
        </span>
        <span style="color: var(--c-text-ghost);">·</span>
        <span>3 build weeks</span>
        <span style="color: var(--c-text-ghost);">·</span>
        <span>15-min talk</span>
        <span style="color: var(--c-text-ghost);">·</span>
        <span>30 marks · 15 + 15</span>
      </div>
    </div>
  </section>

  {/* ─────────────────────────  Five roles  ─────────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 01 · The Five Roles
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          One spectrum, five voices.
        </h2>
        <p
          class="mt-4 max-w-[64ch] text-[15px]"
          style="color: var(--c-text-soft);"
        >
          Each student takes one role. Role 1 opens the story and Role 5 closes
          it, and every part hands off to the next — so the five voices read as a
          single continuous story from the Particle Age to the Stellar Age.
        </p>
      </div>

      <ol class="grid md:grid-cols-2 gap-4">
        {
          roles.map((r, i) => (
            <li data-fade style={`--delay: ${i * 70}ms`} class="surface-card">
              <div class="flex items-baseline gap-3 mb-3">
                <span
                  class="font-mono text-[11px] tracking-[0.22em] uppercase"
                  style="color: var(--c-accent);"
                >
                  Role {r.n}
                </span>
                <span
                  class="ml-auto font-mono text-[10px] tracking-[0.22em] uppercase"
                  style="color: var(--c-text-faint);"
                >
                  ↳ Ch {r.chapter}
                </span>
              </div>
              <div
                class="font-serif font-medium leading-tight"
                style="font-size: 1.45rem; color: var(--c-text-strong);"
              >
                {r.title}
              </div>
              <div
                class="font-serif italic mt-1 mb-3"
                style="color: var(--c-text-soft); font-size: 1.05rem;"
              >
                {r.subtitle}
              </div>
              <p
                class="text-[14px] font-sans leading-[1.6]"
                style="color: var(--c-text-soft);"
              >
                {r.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ───────────────────────  The three-week build  ─────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 02 · The Build
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Three weeks, three steps.
        </h2>
        <p
          class="mt-4 max-w-[68ch] text-[15px]"
          style="color: var(--c-text-soft);"
        >
          The project isn't built the night before — it grows over three in-class
          sessions, each submitted as a{" "}
          <span style="color: var(--c-text-strong);">progress report</span> on
          Kriterion. Every step is a small, real piece of the work: up to 100
          words and one annotated image — hand-drawn or AI-assisted, either is
          fine. Gather finds the evidence, Develop
          explains it, Weave connects it — and together they become the report
          you write and the talk you give.
        </p>
      </div>

      <ol class="grid md:grid-cols-3 gap-4">
        {
          build.map((b, i) => (
            <li
              data-fade
              style={`--delay: ${i * 90}ms`}
              class="surface-card flex flex-col"
            >
              <div class="flex items-baseline justify-between mb-2">
                <span
                  class="font-mono text-[10px] tracking-[0.22em] uppercase"
                  style="color: var(--c-accent);"
                >
                  {b.tag}
                </span>
                <span
                  class="font-mono text-[11px]"
                  style="color: var(--c-text-faint);"
                >
                  0{b.n}
                </span>
              </div>
              <div
                class="font-serif font-medium leading-tight"
                style="font-size: 1.7rem; color: var(--c-text-strong);"
              >
                {b.word}
              </div>
              <p
                class="font-serif italic mt-1 mb-4 text-[15px]"
                style="color: var(--c-text-soft);"
              >
                {b.essence}
              </p>
              <ul class="space-y-2 mb-4">
                {b.doing.map((d) => (
                  <li
                    class="flex gap-2.5 text-[13.5px] font-sans leading-[1.5]"
                    style="color: var(--c-text-soft);"
                  >
                    <span
                      class="mt-[7px] shrink-0 w-1.5 h-1.5 rounded-full"
                      style="background: var(--c-accent);"
                    />
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
              <div
                class="mt-auto pt-3"
                style="border-top: 1px dashed var(--c-border);"
              >
                <div
                  class="font-mono text-[10px] tracking-[0.18em] uppercase mb-1"
                  style="color: var(--c-text-faint);"
                >
                  You submit
                </div>
                <p
                  class="text-[12.5px] font-sans leading-[1.5]"
                  style="color: var(--c-text-soft);"
                >
                  {b.submit}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ─────────────────────────────  Tools  ──────────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
      <div data-fade>
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 03 · Tools
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.6rem, 3vw, 2.1rem);"
        >
          Archives & atlases.
        </h2>
        <p
          class="mt-4 text-[14px] max-w-[40ch]"
          style="color: var(--c-text-soft);"
        >
          Every image is public — no original capture required. You start pulling
          them from the Gather session and keep drawing on them through Develop
          and Weave.
        </p>
      </div>

      <ul data-fade style="--delay: 180ms" class="grid sm:grid-cols-2 gap-3">
        {
          tools.map((t) => (
            <li>
              <a
                href={t.href}
                target="_blank"
                rel="noopener"
                class="surface-card is-link block h-full"
              >
                <div
                  class="font-mono text-[11px] tracking-[0.22em] uppercase"
                  style="color: var(--c-accent);"
                >
                  {t.label}
                </div>
                <div
                  class="mt-2 text-[13px]"
                  style="color: var(--c-text-soft);"
                >
                  {t.note}
                </div>
                <div
                  class="mt-2 text-[10px] font-mono tracking-[0.2em] uppercase"
                  style="color: var(--c-text-faint);"
                >
                  ↗ open
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ─────────────────────────  Deliverables  ──────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 04 · Deliverables
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          What each group submits.
        </h2>
        <p
          class="mt-4 max-w-[64ch] text-[15px]"
          style="color: var(--c-text-soft);"
        >
          Your three weeks of Gather, Develop, and Weave now converge into two
          deliverables, both submitted per group on{" "}
          <span style="color: var(--c-text-strong);">Kriterion</span> — not
          Google Classroom. All five students prepare their own part; one person
          merges everything and submits a single file or link on behalf of the
          whole group.
        </p>
      </div>

      {/* Sample presentation — large call-to-action button */}
      <a
        data-fade
        style="--delay: 120ms"
        href={SAMPLE_PRESENTATION}
        target="_blank"
        rel="noopener"
        class="group block mb-6 rounded-2xl px-6 md:px-8 py-6 md:py-7 transition-colors hover:bg-[rgb(var(--c-accent-rgb)/0.06)]"
        style="border: 1px solid var(--c-border); background: rgb(var(--c-accent-rgb) / 0.04);"
      >
        <div class="flex items-center gap-5 flex-wrap">
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full shrink-0"
            style="background: rgb(var(--c-accent-rgb) / 0.12); color: var(--c-accent);"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="14" rx="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          </span>
          <div class="min-w-0">
            <div
              class="font-mono text-[10px] tracking-[0.28em] uppercase mb-1"
              style="color: var(--c-accent);"
            >
              Sample presentation
            </div>
            <div
              class="font-serif font-medium leading-tight"
              style="font-size: clamp(1.3rem, 2.6vw, 1.7rem); color: var(--c-text-strong);"
            >
              Open the Canva template structure →
            </div>
            <p class="mt-1.5 text-[13px] max-w-[60ch]" style="color: var(--c-text-soft);">
              This is the structure your presentation must follow.{" "}
              <span style="color: var(--c-text-strong);">Copy it into your own
              Canva</span> and edit it together as a group — each student
              builds their segment on the same theme and layout.
            </p>
          </div>
          <span
            class="ml-auto font-mono text-[10px] tracking-[0.22em] uppercase shrink-0 transition-transform group-hover:translate-x-1"
            style="color: var(--c-text-faint);"
          >
            ↗ open
          </span>
        </div>
      </a>

      <div data-fade style="--delay: 180ms" class="grid md:grid-cols-2 gap-4">
        <div class="surface-card">
          <div
            class="font-mono text-[10px] tracking-[0.22em] uppercase mb-3"
            style="color: var(--c-accent);"
          >
            Report → Kriterion · Mid report
          </div>
          <div
            class="font-serif font-medium leading-tight mb-2"
            style="font-size: 1.3rem; color: var(--c-text-strong);"
          >
            One PDF, five voices.
          </div>
          <p
            class="text-[14px] font-sans leading-[1.6]"
            style="color: var(--c-text-soft);"
          >
            Each student writes 400–600 words on their role — the images they
            gathered, the science they developed, and how their part weaves into
            the group's story — with their annotated figures. One member merges
            all five sections plus a shared intro and conclusion into a single
            PDF and uploads it to the{" "}
            <span style="color: var(--c-text-strong);">Mid report</span> on
            Kriterion. One PDF per group — not per student.
          </p>
        </div>

        <div class="surface-card">
          <div
            class="font-mono text-[10px] tracking-[0.22em] uppercase mb-3"
            style="color: var(--c-accent);"
          >
            Presentation → Kriterion · Canva link
          </div>
          <div
            class="font-serif font-medium leading-tight mb-2"
            style="font-size: 1.3rem; color: var(--c-text-strong);"
          >
            15 minutes, one story.
          </div>
          <p
            class="text-[14px] font-sans leading-[1.6]"
            style="color: var(--c-text-soft);"
          >
            Each student presents their section for 3–4 minutes (Role 1 →
            Role 5 in order), minimum 4 slides each including a title slide,
            following the sample structure above. One member merges every
            segment into a single Canva deck and submits its{" "}
            <span style="color: var(--c-text-strong);">link in the
            presentation section</span> of Kriterion.
          </p>
        </div>
      </div>

      {/* How submission works on Kriterion — the one-shot, per-group mechanic */}
      <div
        data-fade
        style="--delay: 260ms; border: 1px solid var(--c-border); background: var(--c-bg-soft);"
        class="mt-4 rounded-xl px-6 py-5"
      >
        <div
          class="font-mono text-[10px] tracking-[0.22em] uppercase mb-2"
          style="color: var(--c-solar, var(--c-accent));"
        >
          ⚠ How submission works on Kriterion
        </div>
        <p class="text-[14px] font-sans leading-[1.6]" style="color: var(--c-text-soft);">
          When you log into Kriterion you'll see the option to submit{" "}
          <span style="color: var(--c-text-strong);">from your group</span>.
          The moment one member submits, the submission locks — no one else in
          the group can submit after that. So decide{" "}
          <span style="color: var(--c-text-strong);">who is responsible</span>{" "}
          ahead of time. That person must gather all five parts into the single
          merged PDF and the single merged Canva deck before submitting, and
          everyone must confirm they're working on a consistent theme and
          structure (different topics, same look) before it goes in. There is
          no individual submission and no resubmission.
        </p>
      </div>
    </div>
  </section>

