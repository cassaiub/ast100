---
import Layout from "../layouts/Layout.astro";
import FigureFrame from "../components/shared/FigureFrame.astro";
import { EnergyRateDensityPanel } from "../components/scenes/0.2/figures";
import { chapterPath, withBase } from "../data/course-nav";

const thinkers = [
  {
    name: "Eric Chaisson",
    idea: "Cosmic Evolution",
    tag: "energy rate density · Φₘ",
    body: "He gave complexity a single number — the energy that flows through every gram of a thing each second — and watched it climb, age after age, from galaxies to plants to brains to the modern world.",
  },
  {
    name: "David Christian",
    idea: "Big History",
    tag: "thresholds of complexity",
    body: "He told the whole past as one continuous account — refusing the old wall between natural science and human history — as the Universe crosses threshold after threshold into ever-greater complexity.",
  },
];

const proof = [
  { label: "Students", value: "200", note: "Summer 2026 · IUB" },
  { label: "Sections", value: "5", note: "Parallel cohorts" },
  { label: "Per section", value: "40", note: "Students each" },
];

const doors = [
  {
    label: "Outline",
    title: "The full plan",
    note: "Seven ages, thirteen weeks, two projects.",
    href: withBase("/outline"),
  },
  {
    label: "Chapter 0",
    title: "Start the story",
    note: "The panoramic view — Big Bang to brain.",
    href: chapterPath(0),
  },
  {
    label: "Timeline",
    title: "The cosmic timeline",
    note: "The whole story on a single scroll.",
    href: withBase("/timeline"),
  },
];
---

<Layout
  title="AST 100 — Our Cosmic History"
  description="Fourteen billion years. One continuous story — and you are its newest chapter. An immersive, scroll-driven introduction to AST 100."
  current="/"
  showBackdrop={true}
>
  {/* Cinematic cool→warm scroll backdrop, over the global starfield. */}
  <div class="fixed inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div id="mood-l1" class="mood-layer mood-l-1" style="opacity: 1"></div>
    <div id="mood-l2" class="mood-layer mood-l-2" style="opacity: 0"></div>
    <div id="mood-l3" class="mood-layer mood-l-3" style="opacity: 0"></div>
    <div id="mood-l4" class="mood-layer mood-l-4" style="opacity: 0"></div>
  </div>

  {/* ─────────────────────────────  Hero  ───────────────────────────── */}
  <section class="relative isolate overflow-hidden -mt-[72px]">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div
        class="absolute inset-0"
        style="background:
          radial-gradient(80% 70% at 50% 0%, rgb(var(--c-accent-rgb) / 0.06), transparent 70%),
          radial-gradient(60% 60% at 20% 80%, rgb(var(--c-nebula-rgb) / 0.10), transparent 70%),
          radial-gradient(70% 60% at 90% 70%, rgb(var(--c-solar-rgb) / 0.05), transparent 70%);"
      ></div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, var(--bg-veil-0) 0%, var(--bg-veil-35) 75%, var(--bg-veil-80) 100%);"
      ></div>
    </div>

    <div
      class="relative max-w-[1100px] mx-auto px-6 md:px-10 pt-[160px] md:pt-[200px] pb-32 md:pb-40"
    >
      <div
        data-fade
        class="font-mono text-[11px] tracking-[0.32em] uppercase text-[var(--c-accent)] mb-7 flex items-center gap-3"
      >
        <span class="block w-9 h-px" style="background: var(--c-accent);"></span>
         The course
      </div>

      <h1
        data-fade
        style="--delay: 220ms"
        class="title-gradient font-serif font-medium tracking-tight leading-[1.02]"
      >
        <span class="block" style="font-size: clamp(2.8rem, 7.6vw, 6.6rem);">
          Our Cosmic History
        </span>
      </h1>

      <p
        data-fade
        style="--delay: 420ms; color: var(--c-text-soft);"
        class="mt-10 max-w-[60ch] text-[18px] md:text-[21px] leading-[1.6] font-serif italic"
      >
        Fourteen billion years. One continuous story — and you are its newest
        chapter.
      </p>

      <div
        data-fade
        style="--delay: 620ms"
        class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-text-faint)]"
      >
        <span class="flex items-center gap-2">
          <span
            class="inline-block w-2 h-2 rounded-full"
            style="background: var(--c-accent); box-shadow: 0 0 10px rgb(var(--c-accent-rgb) / 0.75);"
          ></span>
           From the Big Bang to brains, minds & culture
        </span>
      </div>

      <div data-fade style="--delay: 820ms" class="mt-14 flex flex-wrap gap-3">
        <a
          href={chapterPath(0)}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-mono text-[11px] tracking-[0.22em] uppercase transition-colors"
          style="background: rgb(var(--c-accent-rgb) / 0.12); border: 1px solid rgb(var(--c-accent-rgb) / 0.45); color: var(--c-accent);"
        >
          Begin · Chapter 0 →
        </a>
        <a
          href="#idea"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-mono text-[11px] tracking-[0.22em] uppercase transition-colors"
          style="border: 1px solid var(--c-border-strong); color: var(--c-text-soft);"
        >
          The story →
        </a>
      </div>

      <div
        class="absolute left-1/2 -translate-x-1/2 bottom-10 scroll-cue font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--c-text-faint)]"
      >
        scroll
      </div>
    </div>
  </section>

  {/* ───────────────────────  § 01 · The idea  ──────────────────────── */}
  <section
    id="idea"
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
      <div data-fade>
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 01 · The idea
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          It is all one story.
        </h2>
      </div>
      <div>
        <div data-fade style="--delay: 180ms" class="prose-cosmic max-w-[68ch]">
          <p>
            For most of history we kept the Universe in separate drawers:
            physics in one, chemistry in another, biology and human history in
            others still. The idea at the heart of this course is that there are
            no drawers. Stars, planets, living cells, thinking minds, and whole
            civilizations are not separate subjects — they are chapters of a
            single fourteen-billion-year story, each one built from the matter
            and the lessons of the chapter before.
          </p>
          <p>
            Two thinkers drew that line most clearly, and this course follows
            where they pointed.
          </p>
        </div>

        <div class="mt-10 grid sm:grid-cols-2 gap-3">
          {
            thinkers.map((t, i) => (
              <div data-fade style={`--delay: ${180 + i * 120}ms`} class="surface-card">
                <div
                  class="font-mono text-[10px] tracking-[0.22em] uppercase"
                  style="color: var(--c-accent);"
                >
                  {t.name}
                </div>
                <div
                  class="font-serif font-medium mt-2 leading-none"
                  style="font-size: clamp(1.7rem, 3.2vw, 2.1rem); color: var(--c-text-strong);"
                >
                  {t.idea}
                </div>
                <div
                  class="mt-2 font-mono text-[11px] tracking-[0.12em]"
                  style="color: var(--c-text-faint);"
                >
                  {t.tag}
                </div>
                <p
                  class="mt-3 text-[14px] font-sans leading-[1.55]"
                  style="color: var(--c-text-soft);"
                >
                  {t.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ───────────────────────  § 02 · The need  ──────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
      <div data-fade>
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 02 · The need
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Science for citizens of the Universe.
        </h2>
      </div>
      <div data-fade style="--delay: 180ms" class="prose-cosmic max-w-[68ch]">
        <p>
          You do not need calculus to belong to the cosmos — you need the story.
          AST 100 is built for students of business, the humanities, and the
          social sciences: people who will lead, write, vote, and create, and
          who deserve to do it as <em>citizens of the Universe</em> rather than
          tourists passing through it.
        </p>
        <p>
          So we trade equations for perspective. Where a number truly matters we
          say it in plain words and real units; everywhere else we lean on
          sight, scale, and story to show you where — and when — you stand in
          fourteen billion years.
        </p>
      </div>
    </div>
  </section>

  {/* ──────────────────────  § 03 · The method  ─────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
      <div data-fade>
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 03 · The method
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          An impossible course, made possible.
        </h2>
      </div>
      <div data-fade style="--delay: 180ms" class="prose-cosmic max-w-[68ch]">
        <p>
          This course could not have been built a year ago. Beginning in the
          spring of 2026, Claude — Anthropic's AI, at claude.ai — laid down the
          skeleton of this website. Then Claude Code, running the Opus model,
          went through it lesson by lesson: rewriting every page in plain
          language and rebuilding the flat diagrams of a textbook as living,
          interactive figures you can take hold of yourself.
        </p>
        <p>
          The result is something new — a textbook that <em>moves</em>,
          assembled at a speed and a depth that simply were not possible before.
        </p>
        <div
          class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] tracking-[0.28em] uppercase"
          style="color: var(--c-text-faint);"
        >
          <span>Spring 2026</span>
          <span style="color: var(--c-text-ghost);">·</span>
          <span>claude.ai</span>
          <span style="color: var(--c-text-ghost);">·</span>
          <span>Opus</span>
        </div>
      </div>
    </div>
  </section>

  {/* ────────────────────  § 04 · The guarantee  ────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
      <div data-fade>
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 04 · The guarantee
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Harnessed by a human expert.
        </h2>
      </div>
      <div data-fade style="--delay: 180ms" class="prose-cosmic max-w-[68ch]">
        <p>
          None of this ran on autopilot. Every lesson and every figure was
          guided by an expert astrophysicist — years of research and university
          teaching beyond the PhD — who checked the facts and, just as
          carefully, checked that each interactive figure faithfully reflects
          the real science it depicts.
        </p>
        <blockquote
          class="mt-7 pl-5 font-serif italic text-[18px] leading-[1.5]"
          style="border-left: 2px solid var(--c-accent); color: var(--c-text-soft);"
        >
          The AI did the building. A human expert decided what was true — and
          what was worth showing.
        </blockquote>
      </div>
    </div>
  </section>

  {/* ───────────────────  § 05 · The experience  ────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10 max-w-[68ch]">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 05 · The experience
        </div>
        <h2
          class="font-serif font-medium leading-tight mb-6"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Every figure is alive.
        </h2>
        <div class="prose-cosmic max-w-[68ch]">
          <p>
            Here is one of those figures — live on this page, not a screenshot.
            It shows Eric Chaisson's measure of complexity: the energy that
            flows through every kilogram of a thing each second (measured in
            watts per kilogram, W/kg — a watt is simply a unit of power, like
            the rating printed on a lightbulb). Both axes count by powers of
            ten. Step through cosmic history and watch the number stay flat for
            billions of years — through the first galaxies and stars — then
            rocket upward more than a millionfold to a modern society.
          </p>
          <p style="color: var(--c-text-faint);">
            Drag the slider, hover the points, or open it fullscreen and use
            your arrow keys.
          </p>
        </div>
      </div>

      <div class="home-figure" data-fade style="--delay: 120ms">
        <FigureFrame label="Energy rate density">
          <EnergyRateDensityPanel client:visible />
        </FigureFrame>
      </div>

      <div data-fade class="mt-10 prose-cosmic max-w-[68ch]">
        <p>
          Every figure works two ways. In the lecture hall, the professor drives
          it on the big screen, narrating each step. At home, you take the
          controls yourself — replaying, pausing, and poking at it until it
          clicks.
        </p>
      </div>
    </div>
  </section>

  {/* ───────────────────────  § 06 · The proof  ─────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 06 · The proof
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Proven with 200 students.
        </h2>
      </div>

      <div data-fade style="--delay: 180ms" class="grid grid-cols-3 gap-3">
        {
          proof.map((row) => (
            <div class="surface-card">
              <div
                class="font-mono text-[10px] tracking-[0.22em] uppercase"
                style="color: var(--c-text-faint);"
              >
                {row.label}
              </div>
              <div
                class="font-serif font-medium mt-3 leading-none"
                style="font-size: clamp(2rem, 5vw, 3.6rem); color: var(--c-text-strong);"
              >
                {row.value}
              </div>
              <div
                class="mt-2 text-[12px] font-sans"
                style="color: var(--c-text-soft);"
              >
                {row.note}
              </div>
            </div>
          ))
        }
      </div>

      <p
        data-fade
        style="--delay: 380ms; color: var(--c-text-faint);"
        class="mt-8 text-[13px] font-sans max-w-[64ch]"
      >
        In the summer of 2026 the course runs at IUB across five sections of
        forty — two hundred students learning the cosmos the same immersive way:
        surrounded by living figures in the lecture hall, and exploring them
        again on their own screens at home.
      </p>
    </div>
  </section>

  {/* ─────────────────────────────  CTA  ────────────────────────────── */}
  <section
    class="relative px-6 md:px-10 py-24 md:py-32"
    style="border-top: 1px solid var(--c-border);"
  >
    <div class="max-w-[1100px] mx-auto">
      <div data-fade class="mb-10">
        <div
          class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--c-accent)] mb-3"
        >
          § 07 · Begin
        </div>
        <h2
          class="font-serif font-medium leading-tight"
          style="font-size: clamp(1.8rem, 3.4vw, 2.4rem);"
        >
          Start anywhere. The story holds.
        </h2>
        <p class="mt-3 text-[15px] max-w-[52ch]" style="color: var(--c-text-soft);">
          Three doors into fourteen billion years — each one opens on the whole.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-3">
        {
          doors.map((d, i) => (
            <a
              href={d.href}
              data-fade
              style={`--delay: ${i * 80}ms`}
              class="surface-card is-link block h-full"
            >
              <div
                class="font-mono text-[10px] tracking-[0.22em] uppercase"
                style="color: var(--c-accent);"
              >
                {d.label}
              </div>
              <div
                class="font-serif font-medium mt-2"
                style="font-size: 1.25rem; color: var(--c-text-strong);"
              >
                {d.title}
              </div>
              <div
                class="mt-2 text-[13px] font-sans leading-[1.5]"
                style="color: var(--c-text-soft);"
              >
                {d.note}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script src="../scripts/mood-arc.ts"></script>
</Layout>
