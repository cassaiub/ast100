---
import { subPath, overviewPath } from "../../../data/course-nav";

interface Sub {
  id: string;
  title: string;
  tag: string;
  tease: string;
  href: string;
  /** If true, this card represents the page the user is already on. */
  isCurrent?: boolean;
}

const subs: Sub[] = [
  { id: "0.0", title: "Seven Ages of the Universe", tag: "overview",   tease: "The whole 14-billion-year story, traced along a river. You are here.",       href: overviewPath(0), isCurrent: true },
  { id: "0.1", title: "Spacetime and Energy-Matter", tag: "STEM",       tease: "How space, time, matter, and energy stitch into one fabric.",               href: subPath("0.1") },
  { id: "0.2", title: "Cosmic Evolution",            tag: "evolve",     tease: "Increasing complexity — the engine that turns hot soup into civilizations.", href: subPath("0.2") },
  { id: "0.3", title: "Observable Universe",         tag: "horizon",    tease: "What we can see, what we cannot, and why the difference matters.",          href: subPath("0.3") },
  { id: "0.4", title: "Light & Telescopes",          tag: "instrument", tease: "How starlight becomes data — and data becomes a picture of the past.",      href: subPath("0.4") },
];
---

<footer
  class="relative mt-32 border-t border-white/[0.07] pb-24 lg:pb-12"
  data-screen-label="04 Footer"
>
  <div class="max-w-[1300px] mx-auto px-6 md:px-10 pt-20 pb-12">
    <div>
      <div
        class="font-mono text-[10px] tracking-[0.28em] uppercase text-white/35 mb-5"
      >
        continue · explore this chapter —
      </div>
      <ul
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 md:gap-6"
      >
        {
          subs.map((s) => (
            <li>
              <a
                href={s.href}
                class={`group flex flex-col gap-1.5 text-left transition-colors duration-500 ${s.isCurrent ? "is-current" : ""}`}
                aria-current={s.isCurrent ? "page" : undefined}
                style={`color: ${s.isCurrent ? "var(--c-accent)" : "var(--c-text-soft)"};`}
              >
                <div class="flex items-baseline gap-3">
                  <span
                    class="font-mono text-[12px] tracking-[0.18em]"
                    style={`color: ${s.isCurrent ? "var(--c-accent)" : "rgb(var(--c-accent-rgb) / 0.85)"};`}
                  >
                    {s.id}
                  </span>
                  <span
                    class="font-mono text-[9px] tracking-[0.22em] uppercase"
                    style="color: var(--c-text-faint);"
                  >
                    {s.tag}
                  </span>
                  {s.isCurrent && (
                    <span
                      class="ml-auto font-mono text-[9px] tracking-[0.22em] uppercase px-2 py-0.5 rounded-full"
                      style="color: var(--c-accent); border: 1px solid rgb(var(--c-accent-rgb) / 0.45);"
                    >
                      here
                    </span>
                  )}
                </div>
                <span
                  class="font-serif group-hover:text-[var(--c-accent)] transition-colors duration-500 leading-tight"
                  style={`font-size: clamp(1rem, 1.4vw, 1.18rem); color: ${s.isCurrent ? "var(--c-accent)" : "var(--c-text-strong)"};`}
                >
                  {s.title}
                </span>
                <span
                  class="text-[12px] leading-[1.5] max-w-[28ch]"
                  style="color: var(--c-text-faint);"
                >
                  {s.tease}
                </span>
                <span
                  class="block h-px w-6 mt-1 transition-all duration-500 group-hover:w-12"
                  style={`background: ${s.isCurrent ? "var(--c-accent)" : "rgb(var(--c-text-rgb) / 0.2)"};`}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>


</footer>
