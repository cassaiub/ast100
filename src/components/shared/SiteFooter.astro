---
/* Universal site footer — appears on every page beneath any page-specific
   footer/PrevNext block. */
const year = new Date().getFullYear();
---
<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer-inner">
    <div class="site-footer-left">
      <span>© {year} AST100</span>
      <span class="sep">·</span>
      <span>All rights reserved</span>
      <span class="sep">·</span>
      <span>CASSA</span>
    </div>
    <div class="site-footer-right">
      Designed with <span class="heart" aria-hidden="true">♥</span><span class="visually-hidden">love</span> by
      <strong>M.O.B. JIHAD</strong>
    </div>
  </div>
</footer>
