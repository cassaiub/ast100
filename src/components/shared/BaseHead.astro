---
import "../../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "AST 100 — Our Cosmic History.",
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<script is:inline>
  /* Anti-flash theme bootstrap. Runs before paint to set
     `data-theme` on <html> so the page renders with the user's
     preferred palette on first load — no light→dark flash. */
  (function () {
    try {
      var saved = localStorage.getItem("theme");
      var theme =
        saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
      document.documentElement.setAttribute("data-theme", theme);
    } catch (_) {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  })();
</script>
