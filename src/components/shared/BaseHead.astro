---
import "../../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "AST 100 — Our Cosmic History.",
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.ico`} sizes="any" />
<link rel="icon" type="image/png" sizes="256x256" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.png`} />
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/apple-touch-icon.png`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<script is:inline>
  /* Anti-flash theme bootstrap. Runs before paint to set
     `data-theme` on <html> so the page renders with the user's
     preferred palette on first load — no light→dark flash. */
  (function () {
    try {
      var saved = localStorage.getItem("theme");
      var theme =
        saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
      document.documentElement.setAttribute("data-theme", theme);
    } catch (_) {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  })();
</script>

<script>
  /* KaTeX auto-render — scans the document body for $…$, $$…$$, \(…\),
     and \[…\] delimiters and replaces them with typeset math. Runs once
     after the DOM is ready, plus again after each React island hydrates
     so dynamically-rendered math inside figures gets typeset too. */
  import renderMathInElement from "katex/contrib/auto-render";
  import "katex/dist/katex.min.css";

  const opts = {
    delimiters: [
      { left: "$$", right: "$$", display: true },
      { left: "\\[", right: "\\]", display: true },
      { left: "\\(", right: "\\)", display: false },
      { left: "$", right: "$", display: false },
    ],
    throwOnError: false,
    ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code", "svg"],
    ignoredClasses: ["katex"],
  };

  function renderAll() {
    try { renderMathInElement(document.body, opts); } catch (_) {}
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderAll);
  } else {
    renderAll();
  }

  /* Re-render after a brief delay so math that lands via React-island
     hydration (client:visible) gets typeset too. KaTeX skips elements
     already wrapped in .katex, so repeated calls are idempotent. The
     third pass at 3500 ms is a safety net for slow-loading or
     intersection-observer-gated islands deep in the page. */
  setTimeout(renderAll, 600);
  setTimeout(renderAll, 1800);
  setTimeout(renderAll, 3500);
</script>
