---
import BaseHead from "../components/shared/BaseHead.astro";
import SiteNav from "../components/shared/SiteNav.astro";
import SiteFooter from "../components/shared/SiteFooter.astro";
import Starfield from "../components/shared/Starfield";
import Rail from "../components/shared/Rail.astro";

interface Props {
  title: string;
  description?: string;
  activeId: string;
  /** Chapter number — used by Rail to pick the right sub-page list. */
  chapter?: number;
  /** Path of the current page, e.g. "/chapter/0/0.1" — used by SiteNav. */
  current?: string;
  starDensity?: number;
}

const {
  title,
  description = "AST 100 — Our Cosmic History.",
  activeId,
  chapter = 0,
  current = "",
  starDensity = 600,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="font-serif antialiased text-[var(--c-text)]">
    <div id="reading-progress" aria-hidden="true"></div>

    <div id="backdrop" class="fixed inset-0 -z-10 overflow-hidden">
      <div id="starfield-root" class="absolute inset-0">
        <Starfield density={starDensity} client:load />
      </div>
      <div class="absolute inset-0 nebula-overlay"></div>
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(180deg, var(--bg-veil-0) 0%, var(--bg-veil-55) 70%, var(--bg-veil-90) 100%);"
      ></div>
    </div>

    <SiteNav current={current} />

    <Rail activeId={activeId} chapter={chapter} />

    <main id="app" class="relative">
      <slot />
    </main>

    <SiteFooter />

    <script src="../scripts/chapter-runtime.ts"></script>
  </body>
</html>
